  CODE : 

int minOperations(vector<vector<int>>& grid, int x) {
    
    int n = grid.size();
    int m = grid[0].size();

    vector<int> med;

    for(int i = 0; i < n; i++) {
        for(int j = 0; j < m; j++) {
            med.push_back(grid[i][j]);
        }
    }

    sort(med.begin(), med.end());
    int size = med.size();

    // nth_element(begin(med), begin(med) + size/2, end(med));  // O(n) median

    int median = med[size / 2];
    int res = 0;

    for(int i = 0; i < size; i++) {
        if(med[i] % x != median % x) return -1;

        res += abs(median - med[i]) / x;
    }

    return res;
}





