CODE : 
 class Solution {
public:
    bool isGood(int i)
    {
        bool changed = false;

        while (i)
        {
            int num = i % 10;

            if ((num == 3) || (num == 4) || (num == 7))
                return false;

            if ((num == 2) || (num == 5) || (num == 6) || (num == 9))
                changed = true;

            i = i / 10;
        }

        return changed;
    }

    int rotatedDigits(int n) {
        int count = 0;

        for (int i = 0; i <= n; i++)
        {
            if (isGood(i))
                count++;
        }

        return count;
    }
};

